{
  "name": "openblogagent",
  "version": "0.1.0",
  "private": true,
  "description": "OpenBlogAgent monorepo foundations",
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @openblog/types --workspace @openblog/logger --workspace @openblog/providers --workspace @openblog/config --workspace @openblog/publishers --workspace @openblog/agents --workspace @openblog/graph --workspace @openblog/shared --workspace @openblog/storage --workspace @openblog/app",
    "build:apps": "npm run build --workspace @openblog/cli --workspace @openblog/server",
    "build": "npm run build:packages && npm run build:apps",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev --workspace @openblog/server",
    "generate": "npm run build && node apps/cli/dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky",
    "start": "npm run build && node apps/cli/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.0.5"
  }
}
