OPENBLOG_APP_NAME=OpenBlogAgent
OPENBLOG_ENV=development
OPENBLOG_PORT=3000
OPENBLOG_LOG_LEVEL=info
# Human-readable logs for development (default: JSON lines on stderr)
OPENBLOG_LOG_PRETTY=false
# Optional: SQLite memory DB path (default: data/openblog-memory.db)
# OPENBLOG_MEMORY_DB_PATH=data/openblog-memory.db

# LLM provider (example values)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=OpenBlogAgent

# Model per step (OpenRouter model ids); unset: OPENROUTER_MODEL. Ollama as a fallback ignores them and uses OLLAMA_MODEL
# OPENBLOG_MODEL_PLANNER=
# OPENBLOG_MODEL_WRITER=
# OPENBLOG_MODEL_EDITOR=
# OPENBLOG_MODEL_SEO=
# OPENBLOG_MODEL_CLASSIFICATION=
# OPENBLOG_MODEL_REVIEW=
# OPENBLOG_MODEL_RESEARCH=

# Optional fallback provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Publishing configuration
OPENBLOG_DEFAULT_PUBLISHER=markdown
OPENBLOG_OUTPUT_DIR=output/articles
OPENBLOG_MARKDOWN_OVERWRITE=false

# WordPress publisher (dummy/example values)
OPENBLOG_WORDPRESS_ENDPOINT=https://example.com/wp-json/wp/v2
OPENBLOG_WORDPRESS_USERNAME=demo_user
OPENBLOG_WORDPRESS_APPLICATION_PASSWORD=dummy_app_password
OPENBLOG_WORDPRESS_STATUS=draft
OPENBLOG_WORDPRESS_ON_EXISTING=update

# Ghost publisher (dummy/example values): Admin API key of a custom integration, formatted <id>:<secret>
OPENBLOG_GHOST_ENDPOINT=https://example.ghost.io
OPENBLOG_GHOST_ADMIN_API_KEY=
OPENBLOG_GHOST_STATUS=draft

# Taxonomy configuration (ALLOW_CREATE accepts only true|false, default false)
OPENBLOG_TAXONOMY_PROVIDER=static
# Static taxonomy offered to the classifier (comma-separated), or a JSON file {"categories":[],"tags":[]}
OPENBLOG_TAXONOMY_CATEGORIES=
OPENBLOG_TAXONOMY_TAGS=
OPENBLOG_TAXONOMY_FILE=
OPENBLOG_TAXONOMY_ALLOW_CREATE=false
OPENBLOG_TAXONOMY_DEFAULT_CATEGORY=Uncategorized
OPENBLOG_TAXONOMY_MAX_TAGS=5
OPENBLOG_TAXONOMY_CACHE_TTL_SECONDS=300

# When articles go live: draft (default, sent as a draft, live after `approve`) | publish_after_approval | publish_if_gate_passes (risky)
OPENBLOG_PUBLICATION_POLICY=draft

# Language of the generated articles (en, it, pt-BR...); a brief's `language` (--language, API body) overrides it for one run
OPENBLOG_CONTENT_LANGUAGE=en

# YAML/JSON file listing the feeds and sitemaps `research collect` reads (see docs/configuration.md)
OPENBLOG_RESEARCH_SOURCES_FILE=

# Grounded generation (--source <url>): skip a source page that cannot be read instead of failing the run
OPENBLOG_SOURCES_ALLOW_PARTIAL=false
# Characters of text kept per source page, and shared by all the pages of one run
OPENBLOG_SOURCES_MAX_CHARS_PER_SOURCE=6000
OPENBLOG_SOURCES_MAX_CHARS_TOTAL=15000

# schedule run-once limits (all optional): runs created / cost incurred in the last 24 hours, and a local time window
OPENBLOG_SCHEDULE_MAX_RUNS_PER_DAY=
OPENBLOG_SCHEDULE_MAX_COST_PER_DAY=
OPENBLOG_SCHEDULE_ALLOWED_WINDOW=
# Minutes after which the lock of a run-once whose process died counts as stale
OPENBLOG_SCHEDULE_LOCK_TTL_MINUTES=120

# Webhook told when a run needs a person (a secret: never logged). Slack and Discord webhooks work with the matching format
OPENBLOG_NOTIFY_WEBHOOK_URL=
# Comma-separated: awaiting_approval, needs_review, failed, budget_exceeded, published, duplicate, schedule_limit_reached
OPENBLOG_NOTIFY_EVENTS=awaiting_approval,needs_review,failed,budget_exceeded
# generic (JSON), slack or discord
OPENBLOG_NOTIFY_FORMAT=generic
# Public address of the server, to link GET /runs/{id} in the message (https://blog.example.com:3000)
OPENBLOG_NOTIFY_BASE_URL=

# Ask the model for an article angle, title and keyword for new candidates when they are collected (one call each; off by default)
OPENBLOG_RESEARCH_ENRICH=false
# ... how many of the best new candidates of a collection (the rest on demand: topics enrich)
OPENBLOG_RESEARCH_ENRICH_LIMIT=5
# Stop enriching in one invocation once the provider-reported cost (USD) reaches this; empty: no limit
OPENBLOG_RESEARCH_MAX_COST=

# Candidates scoring at least this (0-100) are accepted without a human when collected; empty: nothing is ever auto-accepted
OPENBLOG_RESEARCH_AUTO_ACCEPT_MIN_SCORE=

# Content fetcher used by research features (feeds, sitemaps, source pages); it refuses loopback, private, link-local and metadata addresses
OPENBLOG_FETCH_ALLOW_PRIVATE=false
# Comma-separated hostnames it may contact (exact match); empty: any public host
OPENBLOG_FETCH_ALLOWED_HOSTS=
OPENBLOG_FETCH_TIMEOUT_MS=15000
OPENBLOG_FETCH_MAX_BYTES=2000000
OPENBLOG_FETCH_MAX_REDIRECTS=5
# User-Agent it sends; empty: OpenBlogAgent/<version> (+repository URL)
OPENBLOG_FETCH_USER_AGENT=

# Generate topics/slugs/titles that were already published (default false; `--force` does it for one run)
OPENBLOG_ALLOW_DUPLICATES=false

# Quality gate: a failing article is regenerated up to MAX_ATTEMPTS times, then parked as needs_review (never published)
# Directory with optional planner.md, writer.md, editor.md, seo.md, classification.md, review.md that replace the instructions of each agent's prompt (see docs/configuration.md)
OPENBLOG_PROMPTS_DIR=

OPENBLOG_QUALITY_MAX_ATTEMPTS=2

# HTTP API (apps/server): the run endpoints answer 503 until a key is set; clients send "Authorization: Bearer <key>" or "X-API-Key: <key>"
OPENBLOG_API_KEY=
# Comma-separated browser origins allowed to call the server; empty: none
OPENBLOG_CORS_ORIGINS=
OPENBLOG_API_CONCURRENCY=1
OPENBLOG_API_QUEUE_SIZE=10
# Minutes without activity after which a started/running run is marked interrupted (server start, "list --recover-stale")
OPENBLOG_RUN_STALE_AFTER_MINUTES=60

# Editorial review: one extra model call scores articles that passed the gate; below MIN_SCORE (0-10) they are parked as needs_review
OPENBLOG_REVIEW_ENABLED=false
OPENBLOG_REVIEW_MIN_SCORE=7

# Per-run budget: a run that uses more tokens (or spends more USD, as reported by the provider) stops with budget_exceeded. Empty: no limit
OPENBLOG_MAX_TOKENS_PER_RUN=
OPENBLOG_MAX_COST_PER_RUN=
OPENBLOG_QUALITY_MIN_WORDS=1000
OPENBLOG_QUALITY_MAX_WORDS=2200
OPENBLOG_QUALITY_MIN_H2=3
OPENBLOG_QUALITY_MIN_OUTLINE_COVERAGE=0.6
OPENBLOG_QUALITY_MIN_EDIT_RATIO=0.7
OPENBLOG_QUALITY_MAX_EDIT_RATIO=1.3
# Only with a target keyword in the brief: its share of the article's words (0.01 = 1%)
OPENBLOG_QUALITY_KEYWORD_MIN_DENSITY=0.005
OPENBLOG_QUALITY_KEYWORD_MAX_DENSITY=0.03
