OPENBLOG_APP_NAME=OpenBlogAgent
OPENBLOG_ENV=development
OPENBLOG_PORT=3000
OPENBLOG_LOG_LEVEL=info
# Human-readable logs for development (default: JSON lines on stderr)
OPENBLOG_LOG_PRETTY=false
# Optional: SQLite memory DB path (default: data/openblog-memory.db)
# OPENBLOG_MEMORY_DB_PATH=data/openblog-memory.db

# LLM provider (example values)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=OpenBlogAgent

# Optional fallback provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Publishing configuration
OPENBLOG_DEFAULT_PUBLISHER=markdown
OPENBLOG_OUTPUT_DIR=output/articles
OPENBLOG_MARKDOWN_OVERWRITE=false

# WordPress publisher (dummy/example values)
OPENBLOG_WORDPRESS_ENDPOINT=https://example.com/wp-json/wp/v2
OPENBLOG_WORDPRESS_USERNAME=demo_user
OPENBLOG_WORDPRESS_APPLICATION_PASSWORD=dummy_app_password
OPENBLOG_WORDPRESS_STATUS=draft
OPENBLOG_WORDPRESS_ON_EXISTING=update

# Taxonomy configuration (ALLOW_CREATE accepts only true|false, default false)
OPENBLOG_TAXONOMY_PROVIDER=static
# Static taxonomy offered to the classifier (comma-separated), or a JSON file {"categories":[],"tags":[]}
OPENBLOG_TAXONOMY_CATEGORIES=
OPENBLOG_TAXONOMY_TAGS=
OPENBLOG_TAXONOMY_FILE=
OPENBLOG_TAXONOMY_ALLOW_CREATE=false
OPENBLOG_TAXONOMY_DEFAULT_CATEGORY=Uncategorized
OPENBLOG_TAXONOMY_MAX_TAGS=5
OPENBLOG_TAXONOMY_CACHE_TTL_SECONDS=300

# When articles go live: draft (default, sent as a draft, live after `approve`) | publish_after_approval | publish_if_gate_passes (risky)
OPENBLOG_PUBLICATION_POLICY=draft

# Generate topics/slugs/titles that were already published (default false; `--force` does it for one run)
OPENBLOG_ALLOW_DUPLICATES=false

# Quality gate: a failing article is regenerated up to MAX_ATTEMPTS times, then parked as needs_review (never published)
OPENBLOG_QUALITY_MAX_ATTEMPTS=2

# Editorial review: one extra model call scores articles that passed the gate; below MIN_SCORE (0-10) they are parked as needs_review
OPENBLOG_REVIEW_ENABLED=false
OPENBLOG_REVIEW_MIN_SCORE=7

# Per-run budget: a run that uses more tokens (or spends more USD, as reported by the provider) stops with budget_exceeded. Empty: no limit
OPENBLOG_MAX_TOKENS_PER_RUN=
OPENBLOG_MAX_COST_PER_RUN=
OPENBLOG_QUALITY_MIN_WORDS=1000
OPENBLOG_QUALITY_MAX_WORDS=2200
OPENBLOG_QUALITY_MIN_H2=3
OPENBLOG_QUALITY_MIN_OUTLINE_COVERAGE=0.6
OPENBLOG_QUALITY_MIN_EDIT_RATIO=0.7
OPENBLOG_QUALITY_MAX_EDIT_RATIO=1.3
